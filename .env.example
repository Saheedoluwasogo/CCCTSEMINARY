# Copy this file to ".env" and adjust the values.

# Port the server listens on
PORT=3000

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Set to "production" when deploying (enables Secure cookies over HTTPS)
NODE_ENV=development

# Optional: where the SQLite database file is stored (defaults to ./data)
# DATA_DIR=./data
